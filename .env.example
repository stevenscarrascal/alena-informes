# --- Aplicación ---
# En local: http://localhost:8080
# En CloudPanel/VPS: la URL pública real, por ejemplo https://informes.tudominio.com
APP_URL="http://localhost:8080"
# Puerto que usará la app en producción (CloudPanel suele dejarlo en 3000 o 8080).
PORT="3000"
HOST="0.0.0.0"
NODE_ENV="production"
# Secreto para firmar/derivar credenciales de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- MySQL ---
# En desarrollo, el servicio MySQL de Herd (root sin contraseña, 127.0.0.1:3306).
# En producción, la base de datos real.
DATABASE_URL="mysql://root:@127.0.0.1:3306/informes"

# --- Almacenamiento S3 (AWS o compatible: DigitalOcean Spaces, Herd local…) ---
# Deja AWS_ENDPOINT vacío para usar AWS S3 real.
AWS_BUCKET="informes"
AWS_ACCESS_KEY_ID="herd"
AWS_SECRET_ACCESS_KEY="secretkey"
AWS_DEFAULT_REGION="us-east-1"
AWS_ENDPOINT="http://localhost:9000"
# URL pública del bucket. No la usa la app (todo se sirve por su propio proxy
# autenticado), se acepta solo por paridad con la convención de Laravel/Herd.
AWS_URL="http://localhost:9000/informes"
# true para el S3 local de Herd, MinIO, DigitalOcean Spaces y la mayoría de
# compatibles; false para AWS S3 real.
AWS_USE_PATH_STYLE_ENDPOINT="true"

# --- Correo SMTP ---
# En desarrollo, el mailcatcher local de Herd.
MAIL_HOST="127.0.0.1"
MAIL_PORT="2526"
MAIL_USERNAME=""
MAIL_PASSWORD=""
# tls (STARTTLS, puerto 587) | ssl (TLS implícito, puerto 465) | null (sin cifrado, buzones de prueba)
MAIL_ENCRYPTION="null"
MAIL_FROM_ADDRESS="informes@proderi.com"
MAIL_FROM_NAME="Alena Informes"
